# --------------------------------------------------
# OnTrac WS API Credentials
# Get these from your OnTrac account setup email
# --------------------------------------------------

# Your OnTrac Web Services ID
ONTRAC_WSID=your_wsid_here

# Your OnTrac Web Services Key
ONTRAC_WSKEY=your_wskey_here

# Your OnTrac Customer Branch code (provided by OnTrac during setup)
ONTRAC_CUSTOMER_BRANCH=your_branch_code_here

# --------------------------------------------------
# Server Config
# --------------------------------------------------

# Railway sets this automatically -- do not change it
PORT=3000

# --------------------------------------------------
# Rate safeguards
# --------------------------------------------------

# What to tell Logiwa when OnTrac answers "NoRate" for a package.
#   unavailable (default) -> no rate; rate shopping picks another carrier
#   zero                  -> a $0 rate (old behaviour; OnTrac then wins every rate shop)
ONTRAC_NORATE_MODE=unavailable

# Optional. Slack incoming-webhook URL; rate problems are posted here (at most once a minute).
SLACK_WEBHOOK_URL=
